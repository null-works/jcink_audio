# Copy to .env on the server and fill in real values. .env is gitignored.
# NEVER commit real credentials. docker-compose.yml reads this via env_file.

# Cloudflare R2 (S3-compatible) — audio storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Spotify Web API — used for Spotify playlist resolution.
# NOTE: the app owner's Spotify account must have an active subscription or
# the API returns 403 "Active premium subscription required for the owner".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dashboard auth. Use a strong, UNIQUE value — do NOT reuse the server
# root/SSH password here.
DASHBOARD_PASSWORD=
DASHBOARD_SECRET_KEY=
